# Скопируйте в .env и заполните.
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Любая модель из https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Адреса локальных llama-server (см. scripts/start_local.sh)
QWEN_URL=http://127.0.0.1:8081/v1
LLAMA_URL=http://127.0.0.1:8082/v1
